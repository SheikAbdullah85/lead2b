# lead2b Environment Configuration Template

# Supabase Credentials (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Webhook Secret for HMAC SHA-256 outbound payloads
WEBHOOK_SIGNING_SECRET=lead2b_super_secret_webhook_key_2026

# Optional: Email Service API Key (e.g. Resend, Brevo)
EMAIL_API_KEY=re_demo_1234567890
EMAIL_FROM_ADDRESS=notifications@lead2b.com

# Offline & Demo Mode Flag
NEXT_PUBLIC_DEMO_MODE=true
